# --- Sesiones ---------------------------------------------------------------
AVISMART_JWT_SECRET=genera-aqui-un-secreto-largo-y-aleatorio

# --- Modo desarrollo -------------------------------------------------------
# true: si no hay SMTP, el enlace de confirmación del formulario de contacto se muestra en pantalla.
# Poner en false en producción.
AVISMART_DEV=false
AVISMART_URL_PUBLICA=http://127.0.0.1:5173

# --- Correo de confirmación (Gmail con contraseña de aplicación) -----------
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tucuenta@gmail.com
# SMTP_PASSWORD=la contraseña de aplicación de 16 letras (sin espacios)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AviSmart <tucuenta@gmail.com>

# --- Cloudflare Turnstile (antibots) ---------------------------------------
# Claves de prueba oficiales que siempre aprueban: sitio 1x00000000000000000000AA
# y secreta 1x0000000000000000000000000000000AA. Vacío = capa desactivada.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Otros -------------------------------------------------------------------
AVISMART_VERIFICAR_DNS=true
AVISMART_PROXIES_CONFIABLES=127.0.0.1,::1,localhost
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AVISMART_DEMO=false
AVISMART_DEMO_PASSWORD=
